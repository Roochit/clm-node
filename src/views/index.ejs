<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title><%= title %></title>
        <!-- ลิงก์ไฟล์ CSS ที่ Tailwind จะ Generate มาใส่ในโฟลเดอร์ public -->
        <link href="/css/tailwind.css" rel="stylesheet">
    </head>

    <body class="bg-gray-200 flex items-center justify-center h-screen">
        <!-- หัวข้อ -->
        <div class="bg-white p-10 rounded-2xl shadow-xl text-center">
            <h1 class="text-4xl font-extrabold text-indigo-600 mb-4">
                🚀 <%= title %>
            </h1>
            <p class="text-gray-500 font-medium">โครงสร้าง Master Template ของคุณพร้อมใช้งานแล้ว!</p>

            <p>
                <%= message %>
            </p>
        </div>

        <!-- ทดลองดึงข้อมูลจากฐานข้อมูล -->
        <div class="mt-6">
            <h2 class="text-2xl font-bold text-gray-800"><%= message %></h2>
            <div class="mt-4 flex flex-col gap-3 text-left">
                <!-- วนลูปข้อมูลผู้ใช้ด้วย EJS -->
                <% users.forEach(user => { %>
                    <div class="bg-gray-100 p-4 rounded-lg border border-gray-200">
                        <p class="font-semibold text-gray-700"><%= user.name %></p>
                        <p class="text-sm text-gray-500"><%= user.email %></p>
                    </div>
                <% }) %>
            </div>
        </div>

    </body>
</html>