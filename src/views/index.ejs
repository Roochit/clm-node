<!-- views/index.ejs -->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 min-h-screen flex items-center justify-center p-4">

    <div class="max-w-md w-full bg-white rounded-2xl shadow-sm border border-gray-200 p-8 text-center">
        <!-- Logo / Icon -->
        <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center mx-auto mb-4 text-xl font-bold">
            🚀
        </div>

        <!-- Header -->
        <span class="inline-block px-3 py-1 text-xs font-medium text-emerald-700 bg-emerald-50 rounded-full mb-3">
            ● ระบบพร้อมใช้งาน
        </span>
        <h1 class="text-2xl font-bold text-gray-900 mb-2"><%= title %></h1>
        <p class="text-sm text-gray-500 mb-6"><%= message %></p>

        <!-- MVC Status (?) -->
        <div class="bg-gray-50 rounded-xl p-4 border border-gray-100 text-left text-xs text-gray-600 space-y-2 font-mono">
            <div class="font-semibold text-gray-700 font-sans pb-1 border-b border-gray-200">
                จุดเชื่อมต่อโครงสร้าง (?)
            </div>
            <div class="flex justify-between">
                <span>Route:</span>
                <span class="text-indigo-600">src/routes/web.js</span>
            </div>
            <div class="flex justify-between">
                <span>Controller:</span>
                <span class="text-indigo-600">src/controllers/HomeController.js</span>
            </div>
            <div class="flex justify-between">
                <span>Model:</span>
                <span class="text-indigo-600">src/models/userModel.js</span>
            </div>
            <div class="flex justify-between">
                <span>View:</span>
                <span class="text-indigo-600">src/views/index.ejs</span>
            </div>
        </div>

        <!-- Footer Note -->
        <p class="text-xs text-gray-400 mt-6">
            แก้ไขหน้านี้ได้ที่ <code class="bg-gray-100 px-1.5 py-0.5 rounded text-gray-600">src/views/index.ejs</code>
        </p>
    </div>

</body>
</html>
