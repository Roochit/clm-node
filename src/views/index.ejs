<div class="mt-6 w-full max-w-lg mx-auto">
    <h2 class="text-2xl font-bold text-gray-800 mb-4"><%= message %></h2>

    <!-- ฟอร์มเพิ่มข้อมูล -->
    <form action="/add" method="POST" class="flex gap-2 mb-6">
        <input type="text" name="name" placeholder="ชื่อ" required class="border border-gray-300 px-3 py-2 rounded-lg flex-1 outline-none focus:border-indigo-500">
        <input type="email" name="email" placeholder="อีเมล" required class="border border-gray-300 px-3 py-2 rounded-lg flex-1 outline-none focus:border-indigo-500">
        <button type="submit" class="bg-indigo-600 text-white px-4 py-2 rounded-lg font-medium hover:bg-indigo-700 transition">เพิ่ม</button>
    </form>

    <!-- รายชื่อผู้ใช้ -->
    <div class="flex flex-col gap-3 text-left">
        <% users.forEach(user => { %>
            <div class="bg-gray-100 p-4 rounded-lg border border-gray-200 flex justify-between items-center shadow-sm">
                <div>
                    <p class="font-semibold text-gray-700"><%= user.name %></p>
                    <p class="text-sm text-gray-500"><%= user.email %></p>
                </div>
                <!-- ปุ่มลบ (ใช้ฟอร์ม POST แทนลิงก์ GET เพื่อความปลอดภัย) -->
                <form action="/delete/<%= user.id %>" method="POST" onsubmit="return confirm('ยืนยันการลบ?');">
                    <button type="submit" class="bg-red-500 text-white text-sm px-3 py-1 rounded-md hover:bg-red-600 transition">ลบ</button>
                </form>
            </div>
        <% }) %>
    </div>
</div>